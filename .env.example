# GearBeat V2 environment variables
# Copy this file to .env.local and fill real values locally / in Vercel.
# Never commit .env.local.

# Supabase public client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase privileged server-only key
# Used only in protected admin/cron/server routes.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL
# Used for metadataBase, sitemap/robots URLs, email links, and callback URLs.
# Production fallback in code is https://gearbeat.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email provider
RESEND_API_KEY=
RESEND_FROM=
REVIEW_FROM_EMAIL=
REVIEW_EMAIL_FROM=

# OTP provider
# Production must use a dedicated high-entropy OTP_HASH_SECRET.
# MOCK_OTP_ENABLED must remain false in production unless explicitly approved for a controlled test.
OTP_HASH_SECRET=
OTP_PROVIDER=mock
MOCK_OTP_ENABLED=false
NEXT_PUBLIC_MOCK_OTP_ENABLED=false

# Cron protection
# Must be at least 12 characters. Use a long random value in production.
CRON_SECRET=

# Tap payment placeholders
# LIVE TAP PAYMENTS ARE NOT ENABLED OR APPROVED.
# Keep sandbox/test keys only until payment hardening, webhook verification,
# idempotency, server-side amount validation, legal/company/bank readiness,
# and explicit approval are complete.
TAP_ENV=sandbox
TAP_SECRET_KEY=
NEXT_PUBLIC_TAP_PUBLIC_KEY=
TAP_WEBHOOK_SECRET=
TAP_LIVE_PAYMENTS_ENABLED=false

# Optional future integrations
PAYMENT_GATEWAY=
PAYMENT_GATEWAY_SECRET_KEY=
WHATSAPP_BUSINESS_TOKEN=
SMS_PROVIDER_API_KEY=
 
# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
